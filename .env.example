APP_NAME="Bastion Peak"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://bastionpeak.internal

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bastion_peak
DB_USERNAME=bastion
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@bastionpeak.internal
MAIL_FROM_NAME="Bastion Peak"

# Banking settings
BASTION_LARGE_TRANSACTION_THRESHOLD=10000
BASTION_FAILED_LOGIN_LOCKOUT=5
BASTION_SESSION_TIMEOUT=120
BASTION_DEPOSIT_REQUIRES_APPROVAL=true
BASTION_PAYMENT_REQUIRES_APPROVAL=true

# Currency
BASTION_DEFAULT_CURRENCY=USD
BASTION_BASE_CURRENCY=USD

# File uploads
BASTION_MAX_UPLOAD_SIZE=5120
BASTION_UPLOAD_PATH=storage/app/uploads
